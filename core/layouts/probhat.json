    "/": { "output": "্", "shift_output": "্", "display": "্" },
    "0": { "output": "০", "shift_output": "০", "display": "০" },
    "1": { "output": "১", "shift_output": "১", "display": "১" },
    "2": { "output": "২", "shift_output": "২", "display": "২" },
