    "backspace": { "key_code": 67, "action": "backspace" },
    "enter": { "key_code": 66, "action": "enter" },
    "shift_left": { "key_code": 59, "action": "shift" },
    "shift_right": { "key_code": 60, "action": "shift" },
    "space": { "key_code": 62, "action": "space" }
  }
