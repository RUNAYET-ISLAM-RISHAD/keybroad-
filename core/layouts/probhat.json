{
  "layout_id": "probhat",
  "name": "Probhat",
  "description": "Probhat layout - popular Bengali keyboard",
  "version": 2,
  "keys": {
    "q": { "output": "দ", "shift_output": "ধ", "display": "দ" },
    "w": { "output": "ূ", "shift_output": "ঊ", "display": "ূ" },
